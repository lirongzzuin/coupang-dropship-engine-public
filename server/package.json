    "@fastify/static": "10.1.8",
    "bcryptjs": "3.0.3",
    "fastify": "5.12.8",
    "iconv-lite": "0.7.3",
    "kysely": "0.29.8",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "sharp": "0.35.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
