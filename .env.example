# ── 필수 ───────────────────────────────────────────────
DOMAIN=admin.example.com
PUBLIC_BASE_URL=https://admin.example.com
POSTGRES_PASSWORD=change-me-long-random
# openssl rand -hex 32  (분실 시 기존 고객정보 복호화 불가 — 안전하게 보관)
PII_KEY=
# openssl rand -hex 16
SESSION_SECRET=

# ── 안전 플래그 (처음엔 그대로 두고 점검 후 하나씩 켜기) ─────
DRY_RUN=true
LIVE_LISTING=false
LIVE_PRICING=false
LIVE_FULFILLMENT=false
LIVE_ORDERING=false
LIVE_CS=false

# ── 쿠팡 (Wing > 판매자정보 > 추가판매정보 > OPEN API 키) ──
MARKET_ADAPTER=coupang
COUPANG_VENDOR_ID=
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# ── 공급처 ────────────────────────────────────────────
# 오너클랜 판매사 계정(API 자동 발주·송장 조회)
OWNERCLAN_USERNAME=
OWNERCLAN_PASSWORD=
OWNERCLAN_SANDBOX=false
# 도매꾹 Open API 키(상품 데이터, 승인 불필요) — openapi.domeggook.com
DOMEGGOOK_API_KEY=
DOMEGGOOK_MARKET=supply

# ── 시장 데이터(네이버) ─────────────────────────────────
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_SEARCHAD_CUSTOMER_ID=
NAVER_SEARCHAD_API_KEY=
NAVER_SEARCHAD_SECRET=
# 네이버 데이터랩(검색어트렌드) 권한이 있는 앱이면 true (없으면 검색광고 검색량 추이로 대체)
NAVER_DATALAB_ENABLED=false
# 구글 트렌드 보조 지표(무료, 문제 생기면 false)
GOOGLE_TRENDS_ENABLED=true
# 쿠팡 파트너스 Open API(선택): 쿠팡 검색 상위 최저가·로켓배송 비율 → 가격 경쟁력 판단
COUPANG_PARTNERS_ACCESS_KEY=
COUPANG_PARTNERS_SECRET_KEY=

# ── 알림(텔레그램 @BotFather 로 봇 생성) ──────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

LOG_LEVEL=info
